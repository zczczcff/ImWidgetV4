set(_IMWIDGETV4_PACKAGE_CMAKE_DIR "${CMAKE_CURRENT_LIST_DIR}")
set(_IMWIDGETV4_DEFAULT_TARGETS_FILE "@IMWIDGETV4_EXPORT_FILE_NAME@")
set(_IMWIDGETV4_REQUESTED_ARCHITECTURE "")
set(_IMWIDGETV4_AVAILABLE_ARCHES "")
foreach(_IMWIDGETV4_KNOWN_ARCHITECTURE IN ITEMS win32 win64)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/ImWidgetV4Targets-${_IMWIDGETV4_KNOWN_ARCHITECTURE}.cmake")
        list(APPEND _IMWIDGETV4_AVAILABLE_ARCHES "${_IMWIDGETV4_KNOWN_ARCHITECTURE}")
    endif()
endforeach()

if(_IMWIDGETV4_AVAILABLE_ARCHES)
    if(DEFINED CMAKE_SIZEOF_VOID_P AND CMAKE_SIZEOF_VOID_P EQUAL 4)
        set(_IMWIDGETV4_REQUESTED_ARCHITECTURE "win32")
    elseif(DEFINED CMAKE_SIZEOF_VOID_P AND CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(_IMWIDGETV4_REQUESTED_ARCHITECTURE "win64")
    else()
        message(FATAL_ERROR "Unable to determine the consumer architecture for the selected ImWidgetV4 SDK.")
    endif()
endif()

set(_IMWIDGETV4_TARGETS_FILE "${_IMWIDGETV4_DEFAULT_TARGETS_FILE}")
if(_IMWIDGETV4_REQUESTED_ARCHITECTURE)
    set(_IMWIDGETV4_TARGETS_FILE "ImWidgetV4Targets-${_IMWIDGETV4_REQUESTED_ARCHITECTURE}.cmake")
endif()

if(NOT EXISTS "${CMAKE_CURRENT_LIST_DIR}/${_IMWIDGETV4_TARGETS_FILE}")
    message(FATAL_ERROR
        "The selected ImWidgetV4 SDK does not provide architecture '${_IMWIDGETV4_REQUESTED_ARCHITECTURE}'. "
        "Available architectures: ${_IMWIDGETV4_AVAILABLE_ARCHES}")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/${_IMWIDGETV4_TARGETS_FILE}")

set(_IMWIDGETV4_METADATA_FILE "${CMAKE_CURRENT_LIST_DIR}/ImWidgetV4SdkMetadata-${_IMWIDGETV4_REQUESTED_ARCHITECTURE}.cmake")
if(EXISTS "${_IMWIDGETV4_METADATA_FILE}")
    include("${_IMWIDGETV4_METADATA_FILE}")
    if(_IMWIDGETV4_REQUESTED_ARCHITECTURE AND ImWidgetV4_SDK_ARCHITECTURE AND
        NOT ImWidgetV4_SDK_ARCHITECTURE STREQUAL _IMWIDGETV4_REQUESTED_ARCHITECTURE)
        message(FATAL_ERROR
            "The selected ImWidgetV4 SDK metadata is for architecture '${ImWidgetV4_SDK_ARCHITECTURE}', "
            "but the consuming project requires '${_IMWIDGETV4_REQUESTED_ARCHITECTURE}'.")
    endif()
    if(ImWidgetV4_SDK_COMPILER_ID AND CMAKE_CXX_COMPILER_ID AND
        NOT ImWidgetV4_SDK_COMPILER_ID STREQUAL CMAKE_CXX_COMPILER_ID)
        message(FATAL_ERROR
            "The selected ImWidgetV4 SDK was built with compiler '${ImWidgetV4_SDK_COMPILER_ID}', "
            "but the consuming project uses '${CMAKE_CXX_COMPILER_ID}'.")
    endif()
    if(ImWidgetV4_SDK_MSVC_TOOLSET AND CMAKE_VS_PLATFORM_TOOLSET AND
        NOT ImWidgetV4_SDK_MSVC_TOOLSET STREQUAL CMAKE_VS_PLATFORM_TOOLSET)
        message(FATAL_ERROR
            "The selected ImWidgetV4 SDK was built with MSVC toolset '${ImWidgetV4_SDK_MSVC_TOOLSET}', "
            "but the consuming project uses '${CMAKE_VS_PLATFORM_TOOLSET}'.")
    endif()
    if(ImWidgetV4_SDK_MSVC_VERSION AND MSVC_VERSION AND
        NOT ImWidgetV4_SDK_MSVC_VERSION STREQUAL MSVC_VERSION)
        message(STATUS
            "ImWidgetV4 SDK MSVC version is ${ImWidgetV4_SDK_MSVC_VERSION}; "
            "consumer MSVC version is ${MSVC_VERSION}. MSVC version is informational only.")
    endif()
    if(ImWidgetV4_SDK_CXX_COMPILER_VERSION AND CMAKE_CXX_COMPILER_VERSION AND
        NOT ImWidgetV4_SDK_CXX_COMPILER_VERSION STREQUAL CMAKE_CXX_COMPILER_VERSION)
        message(STATUS
            "ImWidgetV4 SDK compiler version is ${ImWidgetV4_SDK_CXX_COMPILER_VERSION}; "
            "consumer compiler version is ${CMAKE_CXX_COMPILER_VERSION}. Compiler version is informational only.")
    endif()
elseif(_IMWIDGETV4_REQUESTED_ARCHITECTURE)
    message(FATAL_ERROR
        "The selected ImWidgetV4 SDK is missing metadata for architecture '${_IMWIDGETV4_REQUESTED_ARCHITECTURE}'.")
endif()

set(ImWidgetV4_VERSION "@PROJECT_VERSION@")
set(ImWidgetV4_SDK_ARCHITECTURE "${_IMWIDGETV4_REQUESTED_ARCHITECTURE}")

function(imwidgetv4_attach_sdk_sources target_name)
    if(NOT TARGET "${target_name}")
        message(FATAL_ERROR "imwidgetv4_attach_sdk_sources target '${target_name}' does not exist.")
    endif()

    get_filename_component(_imwidgetv4_sdk_root "${_IMWIDGETV4_PACKAGE_CMAKE_DIR}/.." ABSOLUTE)
    set(_imwidgetv4_sdk_source_root "${_imwidgetv4_sdk_root}/src")
    if(NOT EXISTS "${_imwidgetv4_sdk_source_root}")
        message(WARNING "ImWidgetV4 SDK source directory was not found: ${_imwidgetv4_sdk_source_root}")
        return()
    endif()

    file(GLOB_RECURSE _imwidgetv4_sdk_sources
        "${_imwidgetv4_sdk_source_root}/*.c"
        "${_imwidgetv4_sdk_source_root}/*.cc"
        "${_imwidgetv4_sdk_source_root}/*.cpp"
        "${_imwidgetv4_sdk_source_root}/*.cxx"
        "${_imwidgetv4_sdk_source_root}/*.h"
        "${_imwidgetv4_sdk_source_root}/*.hpp"
        "${_imwidgetv4_sdk_source_root}/*.inl"
    )

    if(NOT _imwidgetv4_sdk_sources)
        return()
    endif()

    if(CMAKE_GENERATOR MATCHES "Visual Studio")
        set_source_files_properties(${_imwidgetv4_sdk_sources} PROPERTIES VS_SETTINGS "ExcludedFromBuild=true")
    else()
        set_source_files_properties(${_imwidgetv4_sdk_sources} PROPERTIES HEADER_FILE_ONLY TRUE)
    endif()
    source_group(TREE "${_imwidgetv4_sdk_source_root}" PREFIX "ImWidgetV4 SDK Sources" FILES ${_imwidgetv4_sdk_sources})
    target_sources("${target_name}" PRIVATE ${_imwidgetv4_sdk_sources})
endfunction()
