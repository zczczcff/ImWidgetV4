include("${CMAKE_CURRENT_LIST_DIR}/ImWidgetV4Targets.cmake")

set(ImWidgetV4_VERSION "@PROJECT_VERSION@")
set(_IMWIDGETV4_PACKAGE_CMAKE_DIR "${CMAKE_CURRENT_LIST_DIR}")

function(imwidgetv4_attach_sdk_sources target_name)
    if(NOT TARGET "${target_name}")
        message(FATAL_ERROR "imwidgetv4_attach_sdk_sources target '${target_name}' does not exist.")
    endif()

    get_filename_component(_imwidgetv4_sdk_root "${_IMWIDGETV4_PACKAGE_CMAKE_DIR}/.." ABSOLUTE)
    set(_imwidgetv4_sdk_source_root "${_imwidgetv4_sdk_root}/src")
    if(NOT EXISTS "${_imwidgetv4_sdk_source_root}")
        message(WARNING "ImWidgetV4 SDK source directory was not found: ${_imwidgetv4_sdk_source_root}")
        return()
    endif()

    file(GLOB_RECURSE _imwidgetv4_sdk_sources
        "${_imwidgetv4_sdk_source_root}/*.c"
        "${_imwidgetv4_sdk_source_root}/*.cc"
        "${_imwidgetv4_sdk_source_root}/*.cpp"
        "${_imwidgetv4_sdk_source_root}/*.cxx"
        "${_imwidgetv4_sdk_source_root}/*.h"
        "${_imwidgetv4_sdk_source_root}/*.hpp"
        "${_imwidgetv4_sdk_source_root}/*.inl"
    )

    if(NOT _imwidgetv4_sdk_sources)
        return()
    endif()

    if(CMAKE_GENERATOR MATCHES "Visual Studio")
        set_source_files_properties(${_imwidgetv4_sdk_sources} PROPERTIES VS_SETTINGS "ExcludedFromBuild=true")
    else()
        set_source_files_properties(${_imwidgetv4_sdk_sources} PROPERTIES HEADER_FILE_ONLY TRUE)
    endif()
    source_group(TREE "${_imwidgetv4_sdk_source_root}" PREFIX "ImWidgetV4 SDK Sources" FILES ${_imwidgetv4_sdk_sources})
    target_sources("${target_name}" PRIVATE ${_imwidgetv4_sdk_sources})
endfunction()
