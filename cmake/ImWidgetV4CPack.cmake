set(CPACK_PACKAGE_NAME "ImWidgetV4")
set(CPACK_PACKAGE_VENDOR "ImWidgetV4")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "ImWidgetV4 SDK and editor")
set(CPACK_PACKAGE_INSTALL_DIRECTORY "ImWidgetV4")
set(CPACK_PACKAGE_FILE_NAME "${CPACK_PACKAGE_NAME}-${CPACK_PACKAGE_VERSION}-${CMAKE_SYSTEM_NAME}")
set(CPACK_VERBATIM_VARIABLES ON)

if(WIN32)
    set(CPACK_GENERATOR "ZIP")
    find_program(IMWIDGETV4_MAKENSIS_EXECUTABLE makensis)
    if(IMWIDGETV4_MAKENSIS_EXECUTABLE)
        list(APPEND CPACK_GENERATOR "NSIS")
        set(CPACK_NSIS_DISPLAY_NAME "ImWidgetV4")
        set(CPACK_NSIS_PACKAGE_NAME "ImWidgetV4")
        set(CPACK_NSIS_ENABLE_UNINSTALL_BEFORE_INSTALL ON)
        set(CPACK_NSIS_MODIFY_PATH OFF)
        set(CPACK_NSIS_EXECUTABLES_DIRECTORY "tools")
        set(CPACK_PACKAGE_EXECUTABLES "ImWidgetV4Editor" "ImWidgetV4 Editor")
        set(CPACK_CREATE_DESKTOP_LINKS "ImWidgetV4Editor")
    endif()
else()
    set(CPACK_GENERATOR "TGZ")
endif()

set(CPACK_COMPONENTS_ALL SDK Tools Templates)
set(CPACK_COMPONENT_SDK_DISPLAY_NAME "ImWidgetV4 SDK")
set(CPACK_COMPONENT_TOOLS_DISPLAY_NAME "ImWidgetV4 Editor")
set(CPACK_COMPONENT_TEMPLATES_DISPLAY_NAME "Project templates")
set(CPACK_COMPONENT_SDK_REQUIRED ON)
set(CPACK_COMPONENT_TOOLS_DEPENDS SDK)
set(CPACK_COMPONENT_TEMPLATES_DEPENDS SDK)

include(CPack)
